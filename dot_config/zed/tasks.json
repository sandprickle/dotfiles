// Static tasks configuration.
[
  {
    "label": "Word Count",
    "command": "wc -w $ZED_FILE",
    "reveal": "always",
    "use_new_terminal": false,
  },
  {
    "label": "cargo run",
    "command": "cargo run",
    "reveal_target": "dock",
    "reveal": "no_focus",
    "use_new_terminal": false,
  },
  {
    "label": "Build & Run main.roc",
    "command": "roc build main.roc && ./main",
    "reveal_target": "dock",
    "reveal": "never",
    "use_new_terminal": false,
  },
  {
    "label": "zig build run",
    "command": "zig build run",
    "reveal": "never",
    "reveal_target": "dock",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
]
